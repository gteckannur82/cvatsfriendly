# Copy to .dev.vars for local development (never commit .dev.vars)

# --- Admin ---
# Comma-separated emails that get the /admin dashboard.
ADMIN_EMAILS=

# --- Cashfree Payments (sandbox) ---
# From the Cashfree merchant dashboard → Developers → API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'production' hits api.cashfree.com; anything else stays on the sandbox.
CASHFREE_ENV=sandbox

# --- AI ---
# Optional: when set, Claude is used for AI features; otherwise Groq, then Workers AI (free tier).
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5)
ANTHROPIC_MODEL=

# Optional: used when ANTHROPIC_API_KEY is not set.
GROQ_API_KEY=
# Optional model override (default openai/gpt-oss-120b)
GROQ_MODEL=

# Optional: return canned AI responses for offline UI development
AI_MOCK=false
